// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUTHOR
  ADMIN
}

enum BookStatus {
  MANUSCRIPT_RECEIVED
  EDITING
  COVER_DESIGN
  TYPESETTING
  PROOFREADING
  ISBN_ASSIGNMENT
  PRINTING
  DISTRIBUTION_SETUP
  PUBLISHED_LIVE
}

enum PrintPartner {
  IN_HOUSE
  REPRO_INDIA
  EPITOME_BOOKS
}

enum Platform {
  AMAZON_INDIA
  FLIPKART
  AMAZON_US
  AMAZON_UK
  BOOKLEAF_STORE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}
enum AiStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}
enum MessageType {
  RESPONSE
  INTERNAL_NOTE
}
enum AiCallKind {
  CLASSIFY_PRIORITY 
  DRAFT_RESPONSE
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role Role
  name String
  isActive Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author Author? 
  assignedTickets Ticket[] @relation("TicketAssignee")  
  messages TicketMessage[]
  @@index([role])
}

model Author {
  id                String   @id @default(cuid())
  authorCode        String   @unique            // "AUTH001"
  userId            String   @unique
  phone             String?                     // nullable: not guaranteed for every author
  city              String?                     // nullable: not guaranteed for every author
  joinedDate        DateTime @db.Date           // JSON: joined_date
  // NOT in the JSON. KB says to "check if bank details are linked" for royalty queries.
  // null = unknown, so the AI must not claim either way.
  bankDetailsLinked Boolean?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  books   Book[]
  tickets Ticket[]
}

model Book {
  id         String     @id @default(cuid())
  bookCode   String     @unique              // "BK001"
  authorId   String
  title      String
  // Nullable: ISBN is assigned late in the pipeline (stage "ISBN Assignment").
  // Not @unique on purpose: duplicate ISBNs are a real support scenario the system must be able to hold.
  isbn       String?
  genre      String
  status     BookStatus

  // Nullable: null until the book is published (BK013, BK015)
  publicationDate DateTime? @db.Date
  // Nullable: MRP is set late in production (BK013, BK015)
  mrp             Decimal?  @db.Decimal(12, 2)
  // Nullable: same reason as MRP
  authorRoyaltyPerCopy Decimal? @db.Decimal(12, 2)

  // Non-null with default 0: books in production have 0 sales and 0 royalty
  totalCopiesSold    Int     @default(0)
  totalRoyaltyEarned Decimal @default(0) @db.Decimal(12, 2)
  royaltyPaid        Decimal @default(0) @db.Decimal(12, 2)
  royaltyPending     Decimal @default(0) @db.Decimal(12, 2) // stored per spec; invariant: earned - paid

  // Nullable: null for authors who have never been paid (BK005, BK010, BK016, BK018)
  lastRoyaltyPayoutDate DateTime? @db.Date
  // Nullable: no print partner until printing starts
  printPartner          PrintPartner?
  // Empty array for books not yet live
  availableOn           Platform[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([authorId])
  @@index([status])
  @@index([isbn])
}

model Ticket {
  id           String @id @default(cuid())
  ticketNumber Int    @unique @default(autoincrement()) 

  authorId String
  // Nullable: null = "General / Account Level" query
  bookId   String?

  subject     String
  description String
  status      TicketStatus @default(OPEN)

  // Effective values shown in the queue. They default to a safe fallback so a ticket
  // is always usable even if the AI fails. Admin overrides write straight to these.
  category TicketCategory @default(GENERAL_INQUIRY)
  priority TicketPriority @default(MEDIUM)

  // AI audit trail. Nullable until the AI call succeeds.
  // Keeping the original AI output lets you measure classification accuracy
  // (aiCategory != category means the admin overrode it).
  aiCategory       TicketCategory?
  aiPriority       TicketPriority?
  aiPriorityReason String?          // short rationale, helps the admin trust or override
  aiStatus         AiStatus         @default(PENDING)
  aiProcessedAt    DateTime?
  categoryOverridden Boolean        @default(false)
  priorityOverridden Boolean        @default(false)

  // Nullable: unassigned until an admin claims it
  assignedToId String?

  // Nullable lifecycle timestamps (useful for SLA and "oldest unresolved" views)
  firstResponseAt DateTime?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      Author             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book        Book?              @relation(fields: [bookId], references: [id], onDelete: SetNull)
  assignedTo  User?              @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages    TicketMessage[]
  attachments TicketAttachment[]
  aiDrafts    AiDraft[]
  aiCalls     AiCall[]

  // Queue filters + "priority then oldest" sort
  @@index([status, priority, createdAt])
  @@index([category])
  @@index([authorId, createdAt])
  @@index([assignedToId])
}

// One row per admin reply or internal note. Author-facing queries must filter type = RESPONSE.
model TicketMessage {
  id        String      @id @default(cuid())
  ticketId  String
  senderId  String
  type      MessageType @default(RESPONSE)
  body      String
  // Nullable: set when this message started from an AI draft (tracks how often drafts are used)
  aiDraftId String?
  createdAt DateTime    @default(now())

  ticket  Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender  User     @relation(fields: [senderId], references: [id])
  aiDraft AiDraft? @relation(fields: [aiDraftId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

// Optional bonus. The UI-only requirement means this can stay empty at first.
model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  fileName  String
  fileUrl   String?  // nullable: UI-only mode has no stored file
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model AiDraft {
  id        String   @id @default(cuid())
  ticketId  String
  content   String
  model     String   // e.g. "claude-haiku-5-5"
  createdAt DateTime @default(now())

  ticket   Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([ticketId, createdAt])
}

model AiCall {
  id           String     @id @default(cuid())
  ticketId     String?    // nullable: keep the log even if the ticket is deleted
  kind         AiCallKind
  model        String
  inputTokens  Int?       // nullable: unknown when the call fails
  outputTokens Int?
  latencyMs    Int?
  success      Boolean
  errorMessage String?    // nullable: only set on failure
  createdAt    DateTime   @default(now())

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([ticketId])
}